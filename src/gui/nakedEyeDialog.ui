              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="screenFovLabel">
              <property name="toolTip">
               <string>The angle that the field of view of Stellarium fills for your eye (normally the height of the screen, seen from where you sit). At this field of view the sky is shown life-size; narrower fields are seen as through an ideal instrument.</string>
              </property>
              <property name="text">
               <string>Field of view for the eye:</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QDoubleSpinBox" name="screenFovSpinBox">
              <property name="toolTip">
               <string>The angle that the field of view of Stellarium fills for your eye (normally the height of the screen, seen from where you sit). At this field of view the sky is shown life-size; narrower fields are seen as through an ideal instrument.</string>
              </property>
              <property name="suffix">
               <string>°</string>
              </property>
              <property name="decimals">
               <number>0</number>
              </property>
              <property name="minimum">
               <double>10.000000000000000</double>
              </property>
              <property name="maximum">
               <double>150.000000000000000</double>
              </property>
              <property name="value">
               <double>55.000000000000000</double>
              </property>
             </widget>
            </item>

      <layout class="QVBoxLayout" name="leftColumn">
         <item>
          <widget class="QGroupBox" name="modeGroupBox">
           <property name="title">
            <string>Naked eye mode</string>
           </property>
           <layout class="QVBoxLayout" name="modeLayout">
            <item>
             <widget class="QCheckBox" name="nakedEyeModeCheckBox">
              <property name="toolTip">
               <string>Render the scene of the photographic mode as the eye sees it, without the effects of a camera. Needs OpenGL 3 or later.</string>
              </property>
              <property name="text">
               <string>Naked eye mode</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="infoLineCheckBox">
              <property name="toolTip">
               <string>Show the state of the eye and the sky quality at the top of the screen</string>
              </property>
              <property name="text">
               <string>Show the information line</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="observerGroupBox">
           <property name="title">
            <string>Observer</string>
           </property>
           <layout class="QGridLayout" name="observerLayout">
            <item row="0" column="0">
             <widget class="QLabel" name="ageLabel">
              <property name="toolTip">
               <string>The age of the observer. It sets the size of the pupil (Watson &amp; Yellott 2012): with the years the pupil opens less in the dark, and less light reaches the retina.</string>
              </property>
              <property name="text">
               <string>Age:</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QDoubleSpinBox" name="ageSpinBox">
              <property name="toolTip">
               <string>The age of the observer. It sets the size of the pupil (Watson &amp; Yellott 2012): with the years the pupil opens less in the dark, and less light reaches the retina.</string>
              </property>
              <property name="suffix">
               <string> years</string>
              </property>
              <property name="decimals">
               <number>0</number>
              </property>
              <property name="minimum">
               <double>10.000000000000000</double>
              </property>
              <property name="maximum">
               <double>90.000000000000000</double>
              </property>
              <property name="value">
               <double>30.000000000000000</double>
              </property>
             </widget>
            </item>

     <layout class="QVBoxLayout" name="modeLayout">
      <item>
       <widget class="QCheckBox" name="nakedEyeModeCheckBox">
        <property name="toolTip">
         <string>Render the scene of the photographic mode as the eye sees it, without the effects of a camera. Needs OpenGL 3 or later.</string>

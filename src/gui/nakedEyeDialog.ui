     <layout class="QGridLayout" name="observerLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="ageLabel">
        <property name="toolTip">
         <string>The age of the observer. It sets the size of the pupil (Watson &amp; Yellott 2012): with the years the pupil opens less in the dark, and less light reaches the retina.</string>
        </property>
        <property name="text">
         <string>Age:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="ageSpinBox">

     <layout class="QVBoxLayout" name="adaptationLayout">
      <item>
       <widget class="QCheckBox" name="instantAdaptationCheckBox">
        <property name="toolTip">
         <string>The eye is always adapted to what it sees. Otherwise it needs time: a fraction of a second for brighter light, up to half an hour in the dark after daylight (the rods take over from the cones after about 10 minutes). The adaptation follows the time of the program when it runs faster than the clock.</string>
        </property>

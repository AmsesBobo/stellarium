     <item>
      <layout class="QVBoxLayout" name="rightColumn">
         <item>
          <widget class="QGroupBox" name="nightVisionGroupBox">
           <property name="title">
            <string>Night vision</string>
           </property>
           <layout class="QVBoxLayout" name="nightVisionLayout">
            <item>
             <widget class="QCheckBox" name="acuityCheckBox">
              <property name="toolTip">
               <string>In dim light the eye resolves less detail (Shaler 1937, Ferwerda et al. 1996): the view is blurred to the finest detail the eye can see.</string>
              </property>
              <property name="text">
               <string>Loss of acuity in the dark</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="noiseCheckBox">
              <property name="toolTip">
               <string>In the dark the rods catch few photons: their number fluctuates, and the view looks grainy (Thompson, Shirley &amp; Ferwerda 2002).</string>
              </property>
              <property name="text">
               <string>Noise of the rods</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="acuityInfoLabel">
              <property name="text">
               <string notr="true"/>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="adaptationGroupBox">
           <property name="title">
            <string>Adaptation</string>
           </property>
           <layout class="QVBoxLayout" name="adaptationLayout">
            <item>
             <widget class="QCheckBox" name="instantAdaptationCheckBox">
              <property name="toolTip">
               <string>The eye is always adapted to what it sees. Otherwise it needs time: a fraction of a second for brighter light, up to half an hour in the dark after daylight (the rods take over from the cones after about 10 minutes). The adaptation follows the time of the program when it runs faster than the clock.</string>
              </property>
              <property name="text">
               <string>Always adapted (no adaptation time)</string>
              </property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="adaptNowLayout">
              <item>
               <widget class="QPushButton" name="adaptNowPushButton">
                <property name="toolTip">
                 <string>Adapt the eye at once to the current view, as if it had been looking at it for a long time</string>
                </property>
                <property name="text">
                 <string>Adapt now</string>
                </property>
               </widget>
              </item>
